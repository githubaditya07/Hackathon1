# UNREAD — Environment Configuration Template
# UNREAD runs 100% locally on-device. No external cloud API keys are required.

# App & Local Development Server
PORT=5173
HOST=localhost
ENVIRONMENT=development

# Optional Local Inference Daemon (e.g., Ollama or llama.cpp)
# Strictly local endpoint only. Cloud endpoints are blocked by CSP.
VITE_LOCAL_MODEL_ENDPOINT=http://localhost:11434
